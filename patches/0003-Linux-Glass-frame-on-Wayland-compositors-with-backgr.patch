+std::vector<gfx::Rect> BrowserFrameViewLinux::GetGlassFrameRegion() const {
+  if (!IsGlassFrameActive()) {
+    return {};
+  }
+
+  BrowserView* const browser_view = GetBrowserView();
+  const gfx::Rect client_bounds = GetBoundsForClientView();
+  std::vector<gfx::Rect> region;
+
+  // Behind see-through contents, the whole window is glass.
+  for (ContentsWebView* contents_web_view :
+       browser_view->GetAllVisibleContentsWebViews()) {
+    if (contents_web_view->is_transparent()) {
+      region.push_back(GetLocalBounds());
+      return region;
+    }
+  }
+
+  // A band across the top of the window.
+  int band_bottom = 0;
+  if (features::kGlassFrameToolbarOpacity.Get() < 1.0 &&
+      browser_view->top_container()) {
+    // The whole top chrome is glass, down to the contents, plus an overlap so
+    // that the contents' rounded corners are backed by glass.
+    views::View* const top_container = browser_view->top_container();
+    const gfx::Rect top_container_bounds = views::View::ConvertRectToTarget(
+        top_container, this, top_container->GetLocalBounds());
+    band_bottom = top_container_bounds.bottom() + GetGlassCornerPadding();
+  } else if (!browser_view->ShouldDrawVerticalTabStrip()) {
+    // The glass covers the tab strip and toolbar, plus a slight overlap into
+    // the contents so that the toolbar's rounded corners are backed by glass.
+    const ClientFrameElementInfo info = browser_view->GetFrameElementInfo();
+    band_bottom = client_bounds.y() + info.top_area_height() +
+                  info.toolbar_preferred_height;
+  }
+  if (band_bottom > 0) {
+    region.emplace_back(0, 0, width(), std::min(band_bottom, height()));
+  }
+
+  if (browser_view->ShouldDrawVerticalTabStrip()) {
+    // The glass spans the full height of the window, as wide as the vertical
+    // tab strip.
+    const int corner_padding = GetGlassCornerPadding();
+    const int max_width =
+        tabs::kVerticalTabStripUncollapsedMaxWidth + corner_padding;
+    int glass_width = max_width;
+    // While the tab strip is being resized, cover the maximum width to avoid
+    // updating the window's regions on every mouse move.
+    if (auto* const controller = tabs::VerticalTabStripStateController::From(
+            browser_view->browser());
+        controller && !controller->IsResizing()) {
+      glass_width = std::min(
+          max_width, (controller->IsCollapsed()
+                          ? tabs::kVerticalTabStripCollapsedWidth
+                          : controller->GetUncollapsedWidth()) +
+                         corner_padding);
+    }
+    // Extend to the outer edge of the frame; the window's clip shape trims it.
+    if (base::i18n::IsRTL()) {
+      const int x = client_bounds.right() - glass_width;
+      region.emplace_back(x, 0, width() - x, height());
+    } else {
+      region.emplace_back(0, 0, client_bounds.x() + glass_width, height());
+    }
+  }
+  return region;
+}
