+
+void BrowserFrameViewLinux::PaintGlassFrameBackground(
+    gfx::Canvas* canvas) const {
+  const std::vector<gfx::Rect> glass_region = GetGlassFrameRegion();
+  CHECK(!glass_region.empty());
+  const SkColor frame_color = SkColorSetA(
+      GetFrameColor(BrowserFrameActiveState::kUseCurrent), SK_AlphaOPAQUE);
+
+  // Outside of the glass, the frame is opaque.
+  {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    for (const auto& rect : glass_region) {
+      canvas->sk_canvas()->clipRect(gfx::RectToSkRect(rect),
+                                    SkClipOp::kDifference);
+    }
+    canvas->DrawColor(frame_color);
+  }
+
+  // Inside, tint the backdrop the compositor blurs. The tint replaces rather
+  // than blends with what is in the buffer, since its alpha is what lets the
+  // blurred backdrop show through.
+  auto* const glass_frame_service = GlassFrameService::GetInstance();
+  const double tint_opacity = GlassFrameService::GetTintOpacity(
+      color_utils::IsDark(frame_color),
+      GetBrowserView()->ShouldDrawVerticalTabStrip(),
+      glass_frame_service && glass_frame_service->HasMultipleOpenProfiles());
+  const SkColor tint = SkColorSetA(
+      frame_color, base::ClampRound<SkAlpha>(tint_opacity * SK_AlphaOPAQUE));
+  for (const auto& rect : glass_region) {
+    canvas->FillRect(rect, tint, SkBlendMode::kSrc);
+  }
+}
