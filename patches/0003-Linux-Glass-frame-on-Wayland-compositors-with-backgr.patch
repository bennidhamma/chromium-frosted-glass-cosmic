@@ -1220,3 +1222,37 @@ void AddChromeColorMixer(ui::ColorProvider* provider,
   mixer[ui::kColorFrameActive] = {SK_ColorDKGRAY};
   mixer[ui::kColorFrameInactive] = {SK_ColorGRAY};
 }
+
+void AddGlassFrameColorMixer(ui::ColorProvider* provider,
+                             const ui::ColorProviderKey& key) {
+  if (key.frame_style != ui::ColorProviderKey::FrameStyle::kGlass) {
+    return;
+  }
+
+  const auto alpha = [](double opacity) {
+    return base::ClampRound<SkAlpha>(std::clamp(opacity, 0.0, 1.0) *
+                                     SK_AlphaOPAQUE);
+  };
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  // Menus opened from glass windows are translucent. MenuScrollViewContainer
+  // asks the window system to blur what is behind translucent menus.
+  const double menu_opacity = features::kGlassFrameMenuOpacity.Get();
+  if (menu_opacity < 1.0) {
+    mixer[ui::kColorMenuBackground] = {
+        ui::SetAlpha(ui::FromTransformInput(), alpha(menu_opacity))};
+  }
+
+  // chrome:// pages are see-through in glass windows with a translucent
+  // toolbar (see ContentsWebView), showing the frame's glass behind them.
+  // Their cards stay mostly opaque, like the surfaces of a frosted desktop
+  // app.
+  if (features::kGlassFrameToolbarOpacity.Get() < 1.0 &&
+      features::kGlassFrameTransparentWebUI.Get()) {
+    mixer[kColorWebuiPageBackground] = {SK_ColorTRANSPARENT};
+    mixer[kColorSettingsWebuiPageBackground] = {SK_ColorTRANSPARENT};
+    mixer[kColorNewTabPageBackground] = {SK_ColorTRANSPARENT};
+    mixer[kColorWebuiCardBackground] = {
+        ui::SetAlpha(ui::FromTransformInput(), alpha(0.6))};
+  }
+}
