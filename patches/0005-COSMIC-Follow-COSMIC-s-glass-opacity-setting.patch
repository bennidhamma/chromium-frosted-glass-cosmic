+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_COSMIC_GLASS_SETTINGS_LINUX_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_COSMIC_GLASS_SETTINGS_LINUX_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+
+// Follows the glass opacity that the COSMIC desktop gives its own frosted
+// windows (Settings > Desktop > Appearance), so that glass browser windows can
+// match it. In COSMIC's theme config, the "frost thickness" setting picks an
+// entry of the "alpha_map", the alpha of window backgrounds, and the "glass
+// opacity" setting shifts the whole map.
+class CosmicGlassSettings {
+ public:
+  // Returns null unless the desktop is COSMIC. `on_changed` runs when the
+  // result of AdjustOpacity() changes.
+  static std::unique_ptr<CosmicGlassSettings> CreateIfOnCosmic(
+      base::RepeatingClosure on_changed);
+
+  CosmicGlassSettings(const CosmicGlassSettings&) = delete;
+  CosmicGlassSettings& operator=(const CosmicGlassSettings&) = delete;
+  ~CosmicGlassSettings();
+
+  // Adjusts `opacity`, chosen to look right with COSMIC's default glass, to
+  // the user's settings. Returns `opacity` until the settings are read, or if
+  // they can't be.
+  double AdjustOpacity(double opacity) const;
+
+  // The alpha of COSMIC's window backgrounds, with the user's settings and
+  // with the default ones.
+  struct Alphas {
+    bool operator==(const Alphas&) const = default;
+
+    double alpha = 0;
+    double default_alpha = 0;
+  };
+
+ private:
+  // Reads and watches the config on a sequence that may block.
+  class Reader;
+
+  explicit CosmicGlassSettings(base::RepeatingClosure on_changed);
+
+  void OnRead(std::optional<Alphas> alphas);
+
+  std::optional<Alphas> alphas_;
+  base::RepeatingClosure on_changed_;
+  base::SequenceBound<Reader> reader_;
+  base::WeakPtrFactory<CosmicGlassSettings> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_COSMIC_GLASS_SETTINGS_LINUX_H_
