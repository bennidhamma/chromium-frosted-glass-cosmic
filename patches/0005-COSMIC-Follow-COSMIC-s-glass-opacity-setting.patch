+
   metrics_reporter_ = std::make_unique<GlassFrameMetricsReporter>(
       g_browser_process->local_state());
 
@@ -243,6 +250,32 @@ size_t GlassFrameService::GetMaxGlassWindows() {
 #endif
 }
 
+#if BUILDFLAG(IS_LINUX)
+double GlassFrameService::AdjustTintOpacityForDesktop(
+    double tint_opacity) const {
+  if (!cosmic_glass_settings_) {
+    return tint_opacity;
+  }
+  // Let through as much more or less of the backdrop as COSMIC's own windows
+  // do, compared to its default glass opacity. Keep a trace of the tint so
+  // that the frame doesn't vanish into the backdrop.
+  const double backdrop_transparency =
+      (1.0 - tint_opacity) *
+      cosmic_glass_settings_->GetBackdropTransparencyScale();
+  return std::clamp(1.0 - backdrop_transparency, 0.05, 1.0);
+}
+
+base::CallbackListSubscription
+GlassFrameService::RegisterDesktopGlassOpacityChangedCallback(
+    base::RepeatingClosure callback) {
+  return desktop_glass_opacity_callbacks_.Add(std::move(callback));
+}
+
+void GlassFrameService::OnDesktopGlassOpacityChanged() {
+  desktop_glass_opacity_callbacks_.Notify();
+}
+#endif  // BUILDFLAG(IS_LINUX)
+
 void GlassFrameService::OnPlatformBlurSupportChanged() {
   OnEligibleStateChanged();
 }
