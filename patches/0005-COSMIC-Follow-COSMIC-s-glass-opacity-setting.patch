new file mode 100644
index 0000000000..f3f9206731
--- /dev/null
+++ b/chrome/browser/ui/views/frame/cosmic_glass_settings_linux.cc
@@ -0,0 +1,261 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/cosmic_glass_settings_linux.h"
+
+#include <algorithm>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_path_watcher.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/ptr_util.h"
+#include "base/nix/xdg_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/thread_pool.h"
+
+namespace {
+
+// COSMIC config entries read here: cosmic/<id>/<version>/<key>.
+constexpr char kModeId[] = "com.system76.CosmicTheme.Mode";
+constexpr char kModeVersion[] = "v1";
+constexpr char kDarkThemeId[] = "com.system76.CosmicTheme.Dark";
+constexpr char kLightThemeId[] = "com.system76.CosmicTheme.Light";
+constexpr char kThemeVersion[] = "v2";
+
+// Entries are small RON values.
+constexpr size_t kMaxEntrySize = 4096;
+
+// The alpha of COSMIC's default glass: the "medium" entry of libcosmic's
+// default AlphaMap.
+constexpr double kDefaultAlpha = 0.76154;
+
+base::FilePath GetEntryPath(const char* id,
+                            const char* version,
+                            const char* key) {
+  return base::FilePath(id).Append(version).Append(key);
+}
+
+// Reads an entry from the system defaults.
+std::optional<std::string> ReadDefaultEntry(
+    const std::vector<base::FilePath>& data_dirs,
+    const base::FilePath& entry) {
+  std::string contents;
+  for (const base::FilePath& data_dir : data_dirs) {
+    if (base::ReadFileToStringWithMaxSize(
+            data_dir.Append("cosmic").Append(entry), &contents,
+            kMaxEntrySize)) {
+      return contents;
+    }
+  }
+  return std::nullopt;
+}
+
+// Reads an entry from the user's config, or else from the system defaults.
+std::optional<std::string> ReadEntry(
+    const base::FilePath& config_dir,
+    const std::vector<base::FilePath>& data_dirs,
+    const base::FilePath& entry) {
+  std::string contents;
+  if (base::ReadFileToStringWithMaxSize(config_dir.Append(entry), &contents,
+                                        kMaxEntrySize)) {
+    return contents;
+  }
+  return ReadDefaultEntry(data_dirs, entry);
+}
+
+// Converts a RON enum variant like "ExtremelyLow2" to the name of the
+// matching alpha_map field, "extremely_low_2".
+std::string ToFieldName(std::string_view variant) {
+  std::string name;
+  for (const char c : variant) {
+    if (base::IsAsciiUpper(c) || base::IsAsciiDigit(c)) {
+      if (!name.empty()) {
+        name += '_';
+      }
+      name += base::ToLowerASCII(c);
+    } else {
+      name += c;
+    }
+  }
+  return name;
+}
+
+// Parses a RON struct of numbers like "(low: 0.8, medium: 0.76,)".
+std::map<std::string, double, std::less<>> ParseNumberStruct(
+    std::string_view ron) {
+  std::map<std::string, double, std::less<>> fields;
+  ron = base::TrimWhitespaceASCII(ron, base::TRIM_ALL);
+  if (!ron.starts_with('(') || !ron.ends_with(')')) {
+    return fields;
+  }
+  ron = ron.substr(1, ron.size() - 2);
+  for (const std::string_view field : base::SplitStringPiece(
+           ron, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const std::vector<std::string_view> name_and_value = base::SplitStringPiece(
+        field, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+    double value;
+    if (name_and_value.size() == 2 &&
+        base::StringToDouble(name_and_value[1], &value)) {
+      fields.emplace(name_and_value[0], value);
+    }
+  }
+  return fields;
+}
+
+std::optional<CosmicGlassSettings::Alphas> ReadAlphas(
+    const base::FilePath& config_dir,
+    const std::vector<base::FilePath>& data_dirs) {
+  const std::optional<std::string> is_dark = ReadEntry(
+      config_dir, data_dirs, GetEntryPath(kModeId, kModeVersion, "is_dark"));
+  const char* const theme_id =
+      is_dark && base::TrimWhitespaceASCII(*is_dark, base::TRIM_ALL) == "false"
+          ? kLightThemeId
+          : kDarkThemeId;
+  const std::optional<std::string> frosted = ReadEntry(
+      config_dir, data_dirs, GetEntryPath(theme_id, kThemeVersion, "frosted"));
+  const std::optional<std::string> alpha_map =
+      ReadEntry(config_dir, data_dirs,
+                GetEntryPath(theme_id, kThemeVersion, "alpha_map"));
+  if (!frosted || !alpha_map) {
+    return std::nullopt;
+  }
+
+  // The "frost thickness" setting picks an entry of the alpha map, and the
+  // "glass opacity" setting shifts the whole map.
+  const auto alphas = ParseNumberStruct(*alpha_map);
+  const auto alpha = alphas.find(
+      ToFieldName(base::TrimWhitespaceASCII(*frosted, base::TRIM_ALL)));
+  if (alpha == alphas.end()) {
+    return std::nullopt;
+  }
+
+  // Compare with COSMIC's default glass: the default thickness ("medium") in
+  // the default, unshifted alpha map.
+  double default_alpha = kDefaultAlpha;
+  if (const std::optional<std::string> default_alpha_map = ReadDefaultEntry(
+          data_dirs, GetEntryPath(theme_id, kThemeVersion, "alpha_map"))) {
+    const auto default_alphas = ParseNumberStruct(*default_alpha_map);
+    if (const auto medium = default_alphas.find("medium");
+        medium != default_alphas.end() && medium->second < 1.0) {
+      default_alpha = medium->second;
+    }
+  }
+
+  return CosmicGlassSettings::Alphas{
+      .alpha = std::clamp(alpha->second, 0.0, 1.0),
+      .default_alpha = default_alpha};
+}
+
+}  // namespace
+
+class CosmicGlassSettings::Reader {
+ public:
+  explicit Reader(
+      base::RepeatingCallback<void(std::optional<Alphas>)> on_read)
+      : on_read_(std::move(on_read)) {
+    std::unique_ptr<base::Environment> env = base::Environment::Create();
+    config_dir_ = base::nix::GetXDGDirectory(env.get(),
+                                             base::nix::kXdgConfigHomeEnvVar,
+                                             base::nix::kDotConfigDir)
+                      .Append("cosmic");
+    data_dirs_ = base::nix::GetXDGDataSearchLocations(env.get());
+
+    // Watch the entries of both themes, since the mode can change too.
+    for (const base::FilePath& entry :
+         {GetEntryPath(kModeId, kModeVersion, "is_dark"),
+          GetEntryPath(kDarkThemeId, kThemeVersion, "frosted"),
+          GetEntryPath(kDarkThemeId, kThemeVersion, "alpha_map"),
+          GetEntryPath(kLightThemeId, kThemeVersion, "frosted"),
+          GetEntryPath(kLightThemeId, kThemeVersion, "alpha_map")}) {
+      auto watcher = std::make_unique<base::FilePathWatcher>();
+      // Unretained is safe: `this` owns the watcher.
+      if (watcher->Watch(config_dir_.Append(entry),
+                         base::FilePathWatcher::Type::kNonRecursive,
+                         base::BindRepeating(&Reader::OnEntryChanged,
+                                             base::Unretained(this)))) {
+        watchers_.push_back(std::move(watcher));
+      }
+    }
+    Read();
+  }
+
+  Reader(const Reader&) = delete;
+  Reader& operator=(const Reader&) = delete;
+  ~Reader() = default;
+
+ private:
+  void OnEntryChanged(const base::FilePath& path, bool error) { Read(); }
+
+  void Read() {
+    const std::optional<Alphas> alphas = ReadAlphas(config_dir_, data_dirs_);
+    DVLOG(1) << "COSMIC glass alpha: "
+             << (alphas ? alphas->alpha : -1) << ", default: "
+             << (alphas ? alphas->default_alpha : -1);
+    on_read_.Run(alphas);
+  }
+
+  base::RepeatingCallback<void(std::optional<Alphas>)> on_read_;
+  base::FilePath config_dir_;
+  std::vector<base::FilePath> data_dirs_;
+  std::vector<std::unique_ptr<base::FilePathWatcher>> watchers_;
+};
+
+// static
+std::unique_ptr<CosmicGlassSettings> CosmicGlassSettings::CreateIfOnCosmic(
+    base::RepeatingClosure on_changed) {
+  const std::optional<std::string> desktop =
+      base::Environment::Create()->GetVar(base::nix::kXdgCurrentDesktopEnvVar);
+  if (!desktop || desktop->find("COSMIC") == std::string::npos) {
+    return nullptr;
+  }
+  return base::WrapUnique(new CosmicGlassSettings(std::move(on_changed)));
+}
+
+CosmicGlassSettings::CosmicGlassSettings(base::RepeatingClosure on_changed)
+    : on_changed_(std::move(on_changed)) {
+  reader_ = base::SequenceBound<Reader>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}),
+      base::BindPostTaskToCurrentDefault(base::BindRepeating(
+          &CosmicGlassSettings::OnRead, weak_factory_.GetWeakPtr())));
+}
+
+CosmicGlassSettings::~CosmicGlassSettings() = default;
+
+double CosmicGlassSettings::AdjustOpacity(double opacity) const {
+  if (!alphas_) {
+    return opacity;
+  }
+  // COSMIC's default alpha maps to `opacity`, and the ranges on either side of
+  // it stretch to fit, so that all of COSMIC's settings have an effect: fully
+  // transparent stays fully transparent, and opaque stays opaque.
+  const auto [alpha, default_alpha] = *alphas_;
+  if (alpha <= default_alpha) {
+    return opacity * alpha / default_alpha;
+  }
+  return opacity + (1.0 - opacity) * (alpha - default_alpha) /
+                       (1.0 - default_alpha);
+}
+
+void CosmicGlassSettings::OnRead(std::optional<Alphas> alphas) {
+  if (alphas == alphas_) {
+    return;
+  }
+  alphas_ = alphas;
+  on_changed_.Run();
+}
