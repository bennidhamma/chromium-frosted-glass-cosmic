+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_TEST_TEST_BACKGROUND_EFFECT_H_
+#define UI_OZONE_PLATFORM_WAYLAND_TEST_TEST_BACKGROUND_EFFECT_H_
+
+#include <ext-background-effect-v1-server-protocol.h>
+
+#include <cstdint>
+#include <optional>
+
+#include "third_party/skia/include/core/SkRegion.h"
+#include "ui/ozone/platform/wayland/test/global_object.h"
+#include "ui/ozone/platform/wayland/test/server_object.h"
+
+struct wl_resource;
+
+namespace wl {
+
+extern const struct ext_background_effect_surface_v1_interface
+    kTestBackgroundEffectSurfaceImpl;
+
+// Server-side ext_background_effect_surface_v1. Like the real protocol, the
+// blur region is double-buffered and only becomes current on
+// wl_surface.commit, which MockSurface forwards via `Commit()`.
+class TestBackgroundEffectSurface : public ServerObject {
+ public:
+  explicit TestBackgroundEffectSurface(wl_resource* resource);
+  TestBackgroundEffectSurface(const TestBackgroundEffectSurface&) = delete;
+  TestBackgroundEffectSurface& operator=(const TestBackgroundEffectSurface&) =
+      delete;
+  ~TestBackgroundEffectSurface() override;
+
+  void set_pending_blur_region(std::optional<SkRegion> region) {
+    pending_blur_region_ = std::move(region);
+    has_pending_blur_region_ = true;
+  }
+
+  void Commit();
+
+  // The committed blur region, or nullopt if no region is set (no effect).
+  const std::optional<SkRegion>& blur_region() const { return blur_region_; }
+
+  // Number of set_blur_region requests received so far.
+  int set_blur_region_count() const { return set_blur_region_count_; }
+  void increment_set_blur_region_count() { ++set_blur_region_count_; }
+
+ private:
+  bool has_pending_blur_region_ = false;
+  std::optional<SkRegion> pending_blur_region_;
+  std::optional<SkRegion> blur_region_;
+  int set_blur_region_count_ = 0;
+};
+
+// Server-side ext_background_effect_manager_v1 global.
+class TestBackgroundEffectManager : public GlobalObject {
+ public:
+  TestBackgroundEffectManager();
+  TestBackgroundEffectManager(const TestBackgroundEffectManager&) = delete;
+  TestBackgroundEffectManager& operator=(const TestBackgroundEffectManager&) =
+      delete;
+  ~TestBackgroundEffectManager() override;
+
+  // Sends the capabilities event to the bound client.
+  void SendCapabilities(uint32_t flags);
+
+  // GlobalObject:
+  void OnBind() override;
+
+ private:
+  uint32_t capabilities_ = EXT_BACKGROUND_EFFECT_MANAGER_V1_CAPABILITY_BLUR;
+};
+
+}  // namespace wl
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_TEST_TEST_BACKGROUND_EFFECT_H_
