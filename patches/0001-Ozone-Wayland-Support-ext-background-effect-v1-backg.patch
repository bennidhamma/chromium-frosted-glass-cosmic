+  if (!state.background_blur_region_px.empty()) {
+    // Unlike for the opaque region, round outwards: blurring a fraction of a
+    // pixel too much is harmless, but rounding inwards drops the thin rects
+    // that callers use to approximate rounded corners.
+    region.reset(wl_compositor_create_region(connection_->compositor()));
