diff --git a/ui/ozone/platform/wayland/host/background_effect_manager.cc b/ui/ozone/platform/wayland/host/background_effect_manager.cc
new file mode 100644
index 0000000000..327f72c8a2
--- /dev/null
+++ b/ui/ozone/platform/wayland/host/background_effect_manager.cc
@@ -0,0 +1,87 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/background_effect_manager.h"
+
+#include <ext-background-effect-v1-client-protocol.h>
+
+#include "base/check_op.h"
+#include "base/logging.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+#include "ui/ozone/platform/wayland/host/wayland_window.h"
+#include "ui/ozone/platform/wayland/host/wayland_window_manager.h"
+
+namespace ui {
+
+namespace {
+constexpr uint32_t kMaxVersion = 1;
+}
+
+// static
+void BackgroundEffectManager::Instantiate(WaylandConnection* connection,
+                                          wl_registry* registry,
+                                          uint32_t name,
+                                          const std::string& interface,
+                                          uint32_t version) {
+  CHECK_EQ(interface, kInterfaceName) << "Expected \"" << kInterfaceName
+                                      << "\" but got \"" << interface << "\"";
+
+  if (connection->background_effect_manager_) {
+    return;
+  }
+
+  auto manager = wl::Bind<ext_background_effect_manager_v1>(
+      registry, name, std::min(version, kMaxVersion));
+  if (!manager) {
+    LOG(ERROR) << "Failed to bind " << kInterfaceName;
+    return;
+  }
+  connection->background_effect_manager_ =
+      std::make_unique<BackgroundEffectManager>(manager.release(), connection);
+}
+
+BackgroundEffectManager::BackgroundEffectManager(
+    ext_background_effect_manager_v1* manager,
+    WaylandConnection* connection)
+    : manager_(manager), connection_(connection) {
+  static constexpr ext_background_effect_manager_v1_listener kListener = {
+      .capabilities = &OnCapabilities,
+  };
+  ext_background_effect_manager_v1_add_listener(manager_.get(), &kListener,
+                                                this);
+}
+
+BackgroundEffectManager::~BackgroundEffectManager() = default;
+
+wl::Object<ext_background_effect_surface_v1>
+BackgroundEffectManager::CreateBackgroundEffectSurface(wl_surface* surface) {
+  return wl::Object<ext_background_effect_surface_v1>(
+      ext_background_effect_manager_v1_get_background_effect(manager_.get(),
+                                                             surface));
+}
+
+// static
+void BackgroundEffectManager::OnCapabilities(
+    void* data,
+    ext_background_effect_manager_v1* manager,
+    uint32_t flags) {
+  auto* self = static_cast<BackgroundEffectManager*>(data);
+  const bool supports_blur =
+      flags & EXT_BACKGROUND_EFFECT_MANAGER_V1_CAPABILITY_BLUR;
+  if (self->supports_blur_ == supports_blur) {
+    return;
+  }
+  self->supports_blur_ = supports_blur;
+
+  // Let windows that already exist know, so that they can stop (or start)
+  // painting translucent backgrounds that rely on the compositor blurring
+  // whatever is behind them.
+  if (auto* window_manager = self->connection_->window_manager()) {
+    for (auto* window : window_manager->GetAllWindows()) {
+      window->OnBackgroundBlurSupportChanged();
+    }
+  }
+}
+
+}  // namespace ui
diff --git a/ui/ozone/platform/wayland/host/background_effect_manager.h b/ui/ozone/platform/wayland/host/background_effect_manager.h
new file mode 100644
