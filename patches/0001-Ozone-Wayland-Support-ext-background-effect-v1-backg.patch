@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_HOST_BACKGROUND_EFFECT_MANAGER_H_
+#define UI_OZONE_PLATFORM_WAYLAND_HOST_BACKGROUND_EFFECT_MANAGER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/ozone/platform/wayland/common/wayland_object.h"
+
+namespace ui {
+
+class WaylandConnection;
+
+// Wraps the ext_background_effect_manager_v1 global, which lets clients ask
+// the compositor to apply effects such as blur to whatever is behind the
+// translucent parts of a surface.
+// See: staging/ext-background-effect/ext-background-effect-v1.xml
+class BackgroundEffectManager
+    : public wl::GlobalObjectRegistrar<BackgroundEffectManager> {
+ public:
+  static constexpr char kInterfaceName[] = "ext_background_effect_manager_v1";
+
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+
+  BackgroundEffectManager(ext_background_effect_manager_v1* manager,
+                          WaylandConnection* connection);
+  BackgroundEffectManager(const BackgroundEffectManager&) = delete;
+  BackgroundEffectManager& operator=(const BackgroundEffectManager&) = delete;
+  ~BackgroundEffectManager();
+
+  // Whether the compositor currently applies blur. The compositor may revoke
+  // or grant the capability at any time (e.g. when the user changes a desktop
+  // setting); when revoked, previously set blur regions stop having an effect.
+  bool supports_blur() const { return supports_blur_; }
+
+  // Creates the background effect object for `surface`. The protocol allows
+  // at most one such object per wl_surface.
+  wl::Object<ext_background_effect_surface_v1> CreateBackgroundEffectSurface(
+      wl_surface* surface);
+
+ private:
+  // ext_background_effect_manager_v1_listener callbacks:
+  static void OnCapabilities(void* data,
+                             ext_background_effect_manager_v1* manager,
+                             uint32_t flags);
+
+  // Wayland object wrapped by this class.
+  wl::Object<ext_background_effect_manager_v1> manager_;
+
+  const raw_ptr<WaylandConnection> connection_;
+
+  bool supports_blur_ = false;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_BACKGROUND_EFFECT_MANAGER_H_
diff --git a/ui/ozone/platform/wayland/host/background_effect_manager_unittest.cc b/ui/ozone/platform/wayland/host/background_effect_manager_unittest.cc
new file mode 100644
index 0000000000..8377fa0154
--- /dev/null
+++ b/ui/ozone/platform/wayland/host/background_effect_manager_unittest.cc
@@ -0,0 +1,182 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/background_effect_manager.h"
+
+#include <ext-background-effect-v1-server-protocol.h>
+
+#include <optional>
+#include <vector>
+
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkRegion.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+#include "ui/ozone/platform/wayland/host/wayland_surface.h"
+#include "ui/ozone/platform/wayland/host/wayland_window.h"
+#include "ui/ozone/platform/wayland/test/mock_surface.h"
+#include "ui/ozone/platform/wayland/test/test_background_effect.h"
+#include "ui/ozone/platform/wayland/test/test_wayland_server_thread.h"
+#include "ui/ozone/platform/wayland/test/wayland_test.h"
+
+namespace ui {
+namespace {
+
+SkRegion RegionFromRects(const std::vector<gfx::Rect>& rects) {
+  SkRegion region;
+  for (const auto& rect : rects) {
+    region.op(SkIRect::MakeXYWH(rect.x(), rect.y(), rect.width(),
+                                rect.height()),
+              SkRegion::kUnion_Op);
+  }
+  return region;
+}
+
+class BackgroundEffectManagerTest : public WaylandTestSimple {
+ public:
+  void SetUp() override {
+    WaylandTestSimple::SetUp();
+    surface_id_ = window_->root_surface()->get_surface_id();
+  }
+
+ protected:
+  // Applies the pending state of the root surface and commits it.
+  void ApplyAndCommit() {
+    window_->root_surface()->ApplyPendingState();
+    window_->root_surface()->Commit();
+  }
+
+  // Returns the blur region the server committed for the root surface, or
+  // nullopt if there is no effect object or no region set.
+  std::optional<SkRegion> GetCommittedBlurRegion() {
+    std::optional<SkRegion> result;
+    PostToServerAndWait([&](wl::TestWaylandServerThread* server) {
+      auto* mock_surface = server->GetObject<wl::MockSurface>(surface_id_);
+      ASSERT_TRUE(mock_surface);
+      if (auto* effect = mock_surface->background_effect_surface()) {
+        result = effect->blur_region();
+      }
+    });
+    return result;
+  }
+
+  bool HasEffectObject() {
+    bool has_effect = false;
+    PostToServerAndWait([&](wl::TestWaylandServerThread* server) {
+      auto* mock_surface = server->GetObject<wl::MockSurface>(surface_id_);
+      ASSERT_TRUE(mock_surface);
+      has_effect = !!mock_surface->background_effect_surface();
+    });
+    return has_effect;
+  }
+
+  uint32_t surface_id_ = 0u;
+};
+
+TEST_F(BackgroundEffectManagerTest, BindsAndReceivesCapabilities) {
+  auto* manager = connection_->background_effect_manager();
+  ASSERT_TRUE(manager);
+  EXPECT_TRUE(manager->supports_blur());
+}
+
+// The effect object is only created once a blur region is actually requested,
+// since most surfaces never use it.
+TEST_F(BackgroundEffectManagerTest, EffectObjectCreatedLazily) {
+  ApplyAndCommit();
+  EXPECT_FALSE(HasEffectObject());
+
+  // Clearing a region that was never set must not create the object either.
+  window_->SetBackgroundBlurRegion(std::nullopt);
+  ApplyAndCommit();
+  EXPECT_FALSE(HasEffectObject());
+
+  window_->SetBackgroundBlurRegion(
+      std::vector<gfx::Rect>{gfx::Rect(0, 0, 100, 40)});
+  ApplyAndCommit();
+  EXPECT_TRUE(HasEffectObject());
+}
+
+TEST_F(BackgroundEffectManagerTest, BlurRegionIsDoubleBuffered) {
+  const std::vector<gfx::Rect> region_px = {gfx::Rect(0, 0, 800, 40),
+                                            gfx::Rect(0, 40, 200, 560)};
+  window_->SetBackgroundBlurRegion(region_px);
+
+  // Nothing is sent until the pending state is applied.
+  EXPECT_FALSE(HasEffectObject());
+
+  ApplyAndCommit();
+  auto committed = GetCommittedBlurRegion();
+  ASSERT_TRUE(committed.has_value());
+  EXPECT_EQ(*committed, RegionFromRects(region_px));
+}
+
+TEST_F(BackgroundEffectManagerTest, BlurRegionIsInSurfaceCoordinates) {
+  window_->root_surface()->set_surface_buffer_scale(2);
+  window_->SetBackgroundBlurRegion(
+      std::vector<gfx::Rect>{gfx::Rect(0, 0, 800, 80)});
+  ApplyAndCommit();
+
+  auto committed = GetCommittedBlurRegion();
+  ASSERT_TRUE(committed.has_value());
+  EXPECT_EQ(*committed, RegionFromRects({gfx::Rect(0, 0, 400, 40)}));
+}
+
+TEST_F(BackgroundEffectManagerTest, UnchangedRegionIsNotResent) {
+  const std::vector<gfx::Rect> region_px = {gfx::Rect(0, 0, 800, 40)};
+  window_->SetBackgroundBlurRegion(region_px);
+  ApplyAndCommit();
+  window_->SetBackgroundBlurRegion(region_px);
+  ApplyAndCommit();
+
+  PostToServerAndWait([&](wl::TestWaylandServerThread* server) {
+    auto* mock_surface = server->GetObject<wl::MockSurface>(surface_id_);
+    ASSERT_TRUE(mock_surface);
+    auto* effect = mock_surface->background_effect_surface();
+    ASSERT_TRUE(effect);
+    EXPECT_EQ(effect->set_blur_region_count(), 1);
+  });
+}
+
+TEST_F(BackgroundEffectManagerTest, ClearingRegionRemovesBlur) {
+  window_->SetBackgroundBlurRegion(
+      std::vector<gfx::Rect>{gfx::Rect(0, 0, 800, 40)});
+  ApplyAndCommit();
+  ASSERT_TRUE(GetCommittedBlurRegion().has_value());
+
+  window_->SetBackgroundBlurRegion(std::nullopt);
+  ApplyAndCommit();
+  EXPECT_TRUE(HasEffectObject());
+  EXPECT_FALSE(GetCommittedBlurRegion().has_value());
+}
+
+TEST_F(BackgroundEffectManagerTest, CapabilityChangesNotifyWindows) {
+  auto* manager = connection_->background_effect_manager();
+  ASSERT_TRUE(manager);
+  ASSERT_TRUE(manager->supports_blur());
+
+  EXPECT_CALL(delegate_, OnBackgroundBlurSupportChanged()).Times(1);
+  PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+    server->background_effect_manager()->SendCapabilities(0);
+  });
+  EXPECT_FALSE(manager->supports_blur());
+  ::testing::Mock::VerifyAndClearExpectations(&delegate_);
+
+  // Re-sending the same capabilities is not a change.
+  EXPECT_CALL(delegate_, OnBackgroundBlurSupportChanged()).Times(0);
+  PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+    server->background_effect_manager()->SendCapabilities(0);
+  });
+  ::testing::Mock::VerifyAndClearExpectations(&delegate_);
+
+  EXPECT_CALL(delegate_, OnBackgroundBlurSupportChanged()).Times(1);
+  PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+    server->background_effect_manager()->SendCapabilities(
+        EXT_BACKGROUND_EFFECT_MANAGER_V1_CAPABILITY_BLUR);
+  });
+  EXPECT_TRUE(manager->supports_blur());
+}
+
+}  // namespace
+}  // namespace ui
