+          gfx::ScaleToEnclosingRect(rect_px, 1.f / scale);
+      wl_region_add(region.get(), rect.x(), rect.y(), rect.width(),
+                    rect.height());
+    }
+  }
+  ext_background_effect_surface_v1_set_blur_region(background_effect_.get(),
+                                                   region.get());
