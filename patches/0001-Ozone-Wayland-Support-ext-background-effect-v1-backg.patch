@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/test/test_background_effect.h"
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "ui/ozone/platform/wayland/test/mock_surface.h"
+#include "ui/ozone/platform/wayland/test/server_object.h"
+#include "ui/ozone/platform/wayland/test/test_region.h"
+
+namespace wl {
+
+namespace {
+
+constexpr uint32_t kBackgroundEffectProtocolVersion = 1;
+
+void SetBlurRegion(wl_client* client,
+                   wl_resource* resource,
+                   wl_resource* region) {
+  auto* effect = GetUserDataAs<TestBackgroundEffectSurface>(resource);
+  effect->increment_set_blur_region_count();
+  if (!region) {
+    effect->set_pending_blur_region(std::nullopt);
+    return;
+  }
+  effect->set_pending_blur_region(*GetUserDataAs<TestRegion>(region));
+}
+
+void GetBackgroundEffect(wl_client* client,
+                         wl_resource* resource,
+                         uint32_t id,
+                         wl_resource* surface) {
+  auto* mock_surface = GetUserDataAs<MockSurface>(surface);
+  if (mock_surface->background_effect_surface()) {
+    wl_resource_post_error(
+        resource,
+        EXT_BACKGROUND_EFFECT_MANAGER_V1_ERROR_BACKGROUND_EFFECT_EXISTS,
+        "background effect exists");
+    return;
+  }
+  wl_resource* effect_resource =
+      CreateResourceWithImpl<TestBackgroundEffectSurface>(
+          client, &ext_background_effect_surface_v1_interface,
+          wl_resource_get_version(resource), &kTestBackgroundEffectSurfaceImpl,
+          id,
+          base::BindOnce(&MockSurface::set_background_effect_surface,
+                         mock_surface->GetWeakPtr(), nullptr));
+  CHECK(effect_resource);
+  mock_surface->set_background_effect_surface(
+      GetUserDataAs<TestBackgroundEffectSurface>(effect_resource));
+}
+
+const struct ext_background_effect_manager_v1_interface
+    kTestBackgroundEffectManagerImpl = {
+        .destroy = DestroyResource,
+        .get_background_effect = GetBackgroundEffect,
+};
+
+}  // namespace
+
+const struct ext_background_effect_surface_v1_interface
+    kTestBackgroundEffectSurfaceImpl = {
+        .destroy = DestroyResource,
+        .set_blur_region = SetBlurRegion,
+};
+
+TestBackgroundEffectSurface::TestBackgroundEffectSurface(wl_resource* resource)
+    : ServerObject(resource) {}
+
+// The MockSurface's pointer to this object is reset by the destroy callback
+// passed to CreateResourceWithImpl(), which also works if the wl_surface is
+// destroyed first, e.g. when the client disconnects.
+TestBackgroundEffectSurface::~TestBackgroundEffectSurface() = default;
+
+void TestBackgroundEffectSurface::Commit() {
+  if (!has_pending_blur_region_) {
+    return;
+  }
+  blur_region_ = std::move(pending_blur_region_);
+  pending_blur_region_.reset();
+  has_pending_blur_region_ = false;
+}
+
+TestBackgroundEffectManager::TestBackgroundEffectManager()
+    : GlobalObject(&ext_background_effect_manager_v1_interface,
+                   &kTestBackgroundEffectManagerImpl,
+                   kBackgroundEffectProtocolVersion) {}
+
+TestBackgroundEffectManager::~TestBackgroundEffectManager() = default;
+
+void TestBackgroundEffectManager::SendCapabilities(uint32_t flags) {
+  capabilities_ = flags;
+  if (resource()) {
+    ext_background_effect_manager_v1_send_capabilities(resource(), flags);
+  }
+}
+
+void TestBackgroundEffectManager::OnBind() {
+  ext_background_effect_manager_v1_send_capabilities(resource(), capabilities_);
+}
+
+}  // namespace wl
