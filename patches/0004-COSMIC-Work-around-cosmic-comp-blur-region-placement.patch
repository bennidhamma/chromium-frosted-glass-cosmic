 #include "base/strings/utf_string_conversions.h"
@@ -14,6 +17,7 @@
 #include "ui/gfx/geometry/point.h"
 #include "ui/gfx/geometry/rect.h"
 #include "ui/gfx/geometry/transform.h"
+#include "ui/ozone/common/features.h"
 #include "ui/ozone/platform/wayland/common/wayland_object.h"
 #include "ui/ozone/platform/wayland/common/wayland_util.h"
 #include "ui/ozone/platform/wayland/host/wayland_buffer_manager_host.h"
@@ -69,7 +73,7 @@ bool WaylandPopup::CreateShellPopup() {
   auto bounds_dip =
       wl::TranslateWindowBoundsToParentDIP(this, xdg_parent_window) -
       xdg_parent_window->GetWindowGeometryOffsetInDIP();
-  bounds_dip.Inset(delegate()->CalculateInsetsInDIP(GetPlatformWindowState()));
+  bounds_dip.Inset(GetWindowGeometryInsetsInDIP(GetPlatformWindowState()));
 
   // At this point, both `bounds` and `anchor_rect` parameters here are in
   // UI coordinates space (i.e ui_scale'd), as they have just been provided by
@@ -208,7 +212,7 @@ void WaylandPopup::SetBoundsInDIP(const gfx::Rect& bounds_dip) {
         wl::TranslateWindowBoundsToParentDIP(this, xdg_parent_window) -
         xdg_parent_window->GetWindowGeometryOffsetInDIP();
     bounds_dip_in_parent.Inset(
-        delegate()->CalculateInsetsInDIP(GetPlatformWindowState()));
+        GetWindowGeometryInsetsInDIP(GetPlatformWindowState()));
 
     // If Wayland moved the popup (for example, a dnd arrow icon), schedule
     // redraw as Aura doesn't do that for moved surfaces. If redraw has not been
@@ -256,7 +260,7 @@ void WaylandPopup::HandlePopupConfigure(const gfx::Rect& bounds_dip) {
   // Bounds are in the geometry space. Need to add decoration insets backs. Note
   // that the window state for WaylandPopup is always `kNormal` now, but we
   // check `pending_configure_state_.window_state` to make it consistent.
-  const auto insets = delegate()->CalculateInsetsInDIP(
+  const auto insets = GetWindowGeometryInsetsInDIP(
       pending_configure_state_.window_state.value_or(
           PlatformWindowState::kNormal));
   pending_configure_state_.bounds_dip->Inset(-insets);
@@ -336,10 +340,38 @@ void WaylandPopup::SetWindowGeometry(
   gfx::Rect geometry_dip(gfx::ScaleToEnclosingRectIgnoringError(
       gfx::Rect(state.bounds_dip.size()), state.ui_scale));
 
-  geometry_dip.Inset(delegate()->CalculateInsetsInDIP(state.window_state));
+  geometry_dip.Inset(GetWindowGeometryInsetsInDIP(state.window_state));
   xdg_popup_->SetWindowGeometry(geometry_dip);
 }
 
+gfx::Vector2d WaylandPopup::GetWindowGeometryOffsetInDIP() const {
+  const gfx::Insets insets =
+      GetWindowGeometryInsetsInDIP(GetPlatformWindowState());
+  return {insets.left(), insets.top()};
+}
+
+gfx::Insets WaylandPopup::GetWindowGeometryInsetsInDIP(
+    PlatformWindowState window_state) const {
+  gfx::Insets insets = delegate()->CalculateInsetsInDIP(window_state);
+  if (IsWaylandBlurRegionRelativeToWindowGeometryEnabled()) {
+    // Affected compositors offset the area they blur behind a popup by the
+    // popup's window geometry offset minus its toplevel's. Make those match,
+    // as far as the popup's decorations allow, so the area covers the popup.
+    // Since positioning uses the same insets, the popup does not move.
+    const WaylandWindow* toplevel = this;
+    while (toplevel->parent_window()) {
+      toplevel = toplevel->parent_window();
+    }
+    if (toplevel != this) {
+      const gfx::Vector2d toplevel_offset =
+          toplevel->GetWindowGeometryOffsetInDIP();
+      insets.set_left(std::min(insets.left(), toplevel_offset.x()));
+      insets.set_top(std::min(insets.top(), toplevel_offset.y()));
+    }
+  }
+  return insets;
+}
+
 void WaylandPopup::AckConfigure(uint32_t serial) {
   if (xdg_popup_) {
     xdg_popup_->AckConfigure(serial);
