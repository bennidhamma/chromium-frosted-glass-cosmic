 ui/ozone/common/features.h                    |  5 +++
 .../platform/wayland/host/wayland_popup.cc    | 40 +++++++++++++++++--
 .../platform/wayland/host/wayland_popup.h     |  5 +++
 .../platform/wayland/host/wayland_window.cc   | 23 +++++++++++
 .../platform/wayland/host/wayland_window.h    |  2 +-
 6 files changed, 96 insertions(+), 5 deletions(-)

diff --git a/ui/ozone/common/features.cc b/ui/ozone/common/features.cc
index 774db0a07a..eef2cf0978 100644
--- a/ui/ozone/common/features.cc
+++ b/ui/ozone/common/features.cc
@@ -4,6 +4,12 @@
 
 #include "ui/ozone/common/features.h"
 
+#include <optional>
+#include <string>
+
+#include "base/environment.h"
+#include "base/feature_list.h"
+
 namespace ui {
 
 // Overlay delegation is required for delegated compositing. This doesn't enable
@@ -14,6 +20,13 @@ BASE_FEATURE(kWaylandOverlayDelegation, base::FEATURE_DISABLED_BY_DEFAULT);
 // enabled.
 BASE_FEATURE(kWaylandFractionalScaleV1, base::FEATURE_ENABLED_BY_DEFAULT);
 
+// Workaround for compositors that interpret the ext-background-effect-v1 blur
+// region relative to the xdg_surface window geometry instead of the surface
+// (cosmic-comp at the time of writing). Shifts the region so that it lands in
+// the right place on such compositors; it is wrong everywhere else.
+BASE_FEATURE(kWaylandBlurRegionRelativeToWindowGeometry,
+             base::FEATURE_DISABLED_BY_DEFAULT);
+
 // Controls whether support for the xdg-toplevel-drag protocol should be
 // enabled. On Lacros it will then be used even if the Exo-only extended-drag
 // protocol is supported.
@@ -58,6 +71,19 @@ bool IsWaylandFractionalScaleV1Enabled() {
   return base::FeatureList::IsEnabled(kWaylandFractionalScaleV1);
 }
 
+bool IsWaylandBlurRegionRelativeToWindowGeometryEnabled() {
+  if (const std::optional<bool> state = base::FeatureList::GetStateIfOverridden(
+          kWaylandBlurRegionRelativeToWindowGeometry)) {
+    return *state;
+  }
+  static const bool is_cosmic = [] {
+    const std::optional<std::string> desktop =
+        base::Environment::Create()->GetVar("XDG_CURRENT_DESKTOP");
+    return desktop && desktop->find("COSMIC") != std::string::npos;
+  }();
+  return is_cosmic;
+}
+
 bool IsWaylandXdgToplevelDragEnabled() {
   return base::FeatureList::IsEnabled(kWaylandXdgToplevelDrag);
 }
