 bool IsWaylandFractionalScaleV1Enabled();
+// Whether to compensate for the blur region misplacement of some compositors.
+// Unless set explicitly, this is enabled on COSMIC, whose compositor is
+// affected.
+bool IsWaylandBlurRegionRelativeToWindowGeometryEnabled();
 bool IsWaylandXdgToplevelDragEnabled();
 bool IsPrettyPrintDrmModesetConfigLogsEnabled();
 bool IsUseDynamicCursorSizeEnabled();
