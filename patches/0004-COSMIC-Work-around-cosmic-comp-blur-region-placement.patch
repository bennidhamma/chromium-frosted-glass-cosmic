 #include "ui/gfx/geometry/rect_conversions.h"
 #include "ui/gfx/geometry/rrect_f.h"
 #include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/geometry/vector2d_conversions.h"
+#include "ui/gfx/geometry/vector2d_f.h"
 #include "ui/gfx/native_ui_types.h"
 #include "ui/gfx/overlay_priority_hint.h"
 #include "ui/ozone/common/bitmap_cursor.h"
@@ -180,6 +184,25 @@ void WaylandWindow::UpdateWindowScale(bool update_bounds) {
 
 void WaylandWindow::SetBackgroundBlurRegion(
     std::optional<std::vector<gfx::Rect>> region_px) {
+  if (region_px && IsWaylandBlurRegionRelativeToWindowGeometryEnabled()) {
+    // Compensate for where the affected compositor puts the region, see the
+    // feature's description. For toplevels, the region ends up relative to
+    // their window geometry. For popups, it ends up offset by twice their own
+    // window geometry offset minus that of their toplevel.
+    gfx::Vector2d offset_dip = GetWindowGeometryOffsetInDIP();
+    if (AsWaylandPopup()) {
+      WaylandWindow* const toplevel = GetRootParentWindow();
+      offset_dip = gfx::Vector2d(2 * offset_dip.x(), 2 * offset_dip.y()) -
+                   (toplevel && toplevel != this
+                        ? toplevel->GetWindowGeometryOffsetInDIP()
+                        : gfx::Vector2d());
+    }
+    const gfx::Vector2d offset_px = gfx::ToRoundedVector2d(
+        gfx::ScaleVector2d(offset_dip, applied_state().window_scale));
+    for (auto& rect : *region_px) {
+      rect -= offset_px;
+    }
+  }
   root_surface()->set_background_blur_region(std::move(region_px));
 }
 
