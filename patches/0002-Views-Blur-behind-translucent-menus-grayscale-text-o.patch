+void MenuScrollViewContainer::UpdateBackgroundBlur() {
+#if BUILDFLAG(IS_LINUX)
+  Widget* const widget = GetWidget();
+  const ui::ColorProvider* const color_provider = GetColorProvider();
+  if (!widget || !color_provider || !widget->GetNativeWindow()) {
+    return;
+  }
+  aura::WindowTreeHost* const host = widget->GetNativeWindow()->GetHost();
+  if (!host) {
+    return;
+  }
+  // Only menus that are platform windows of their own can request a blur.
+  auto* const desktop_host = DesktopWindowTreeHostPlatform::GetHostForWidget(
+      host->GetAcceleratedWidget());
+  if (!desktop_host || !desktop_host->platform_window()) {
+    return;
+  }
+
+  std::optional<std::vector<gfx::Rect>> blur_region;
+  const SkColor background_color = color_provider->GetColor(
+      border_color_id_.value_or(ui::kColorMenuBackground));
+  if (SkColorGetA(background_color) < SK_AlphaOPAQUE) {
+    // The background is the rounded body of the menu, without any shadow.
+    gfx::RectF body_bounds(GetLocalBounds());
+    gfx::RoundedCornersF body_corners = background_rounded_corners_;
+    if (bubble_border_) {
+      // Same as the bubble border's client rect.
+      body_bounds.Inset(gfx::InsetsF(bubble_border_->GetInsets()));
+      body_corners = bubble_border_->rounded_corners();
+    }
+    SkRRect body = SkRRect(gfx::RRectF(body_bounds, body_corners));
+    gfx::Point origin;
+    View::ConvertPointToWidget(this, &origin);
+    body.offset(origin.x(), origin.y());
+    blur_region = GetRegionInsideClip(
+        body, gfx::ToEnclosingRect(gfx::SkRectToRectF(body.rect())),
+        host->device_scale_factor());
+  }
+  desktop_host->platform_window()->SetBackgroundBlurRegion(
+      std::move(blur_region));
+#endif  // BUILDFLAG(IS_LINUX)
 }
 
