@@ -239,12 +249,34 @@ std::vector<gfx::Rect> GetRestoredOpaqueRegion(
       std::ceil(translucent_top_area_height_dip * scale - rect.y()));
   region.op(translucent_top_area_rect, SkRegion::kDifference_Op);
 
-  // Convert the region to a list of rectangles.
-  std::vector<gfx::Rect> opaque_region;
-  for (SkRegion::Iterator i(region); !i.done(); i.next()) {
-    opaque_region.push_back(gfx::SkIRectToRect(i.rect()));
+  return RegionToRects(region);
+}
+
+std::vector<gfx::Rect> GetRegionInsideClip(const SkRRect& clip_region,
+                                           const gfx::Rect& area_dip,
+                                           float scale) {
+  SkRRect clip_region_px;
+  if (!clip_region.transform(SkMatrix::Scale(scale, scale), &clip_region_px)) {
+    return {};
+  }
+  // Conservatively round the area inwards, and let Skia rasterize the rounded
+  // corners: only pixels whose centers are inside the clip are included.
+  const SkRegion area_px(
+      gfx::RectToSkIRect(gfx::ScaleToEnclosedRect(area_dip, scale)));
+  SkRegion region;
+  region.setPath(SkPath::RRect(clip_region_px), area_px);
+  return RegionToRects(region);
+}
+
+std::vector<gfx::Rect> SubtractRectFromRegion(
+    const std::vector<gfx::Rect>& region_px,
+    const gfx::Rect& rect_px) {
+  SkRegion region;
+  for (const auto& rect : region_px) {
+    region.op(gfx::RectToSkIRect(rect), SkRegion::kUnion_Op);
   }
-  return opaque_region;
+  region.op(gfx::RectToSkIRect(rect_px), SkRegion::kDifference_Op);
+  return RegionToRects(region);
 }
 
 }  // namespace views
