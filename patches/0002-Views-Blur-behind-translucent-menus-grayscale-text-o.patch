+std::vector<gfx::Rect> RegionToRects(const SkRegion& region) {
+  std::vector<gfx::Rect> rects;
+  for (SkRegion::Iterator i(region); !i.done(); i.next()) {
+    rects.push_back(gfx::SkIRectToRect(i.rect()));
+  }
+  return rects;
+}
+
