new file mode 100644
index 0000000000..a269c4e1e9
--- /dev/null
+++ b/ui/views/window/frame_view_utils_linux_unittest.cc
@@ -0,0 +1,98 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/window/frame_view_utils_linux.h"
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "third_party/skia/include/core/SkRegion.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+
+namespace views {
+
+namespace {
+
+SkRegion ToSkRegion(const std::vector<gfx::Rect>& rects) {
+  SkRegion region;
+  for (const auto& rect : rects) {
+    region.op(gfx::RectToSkIRect(rect), SkRegion::kUnion_Op);
+  }
+  return region;
+}
+
+SkRRect MakeRoundedClip(const gfx::Rect& bounds, float top_radius) {
+  const SkVector radii[4] = {{top_radius, top_radius},
+                             {top_radius, top_radius},
+                             {0, 0},
+                             {0, 0}};
+  SkRRect rrect;
+  rrect.setRectRadii(gfx::RectToSkRect(bounds), radii);
+  return rrect;
+}
+
+}  // namespace
+
+TEST(FrameViewUtilsLinuxTest, RegionInsideRectangularClip) {
+  const SkRRect clip = SkRRect::MakeRect(SkRect::MakeWH(800, 600));
+  const auto region =
+      GetRegionInsideClip(clip, gfx::Rect(0, 0, 800, 80), /*scale=*/1.f);
+  EXPECT_EQ(ToSkRegion(region), SkRegion(SkIRect::MakeWH(800, 80)));
+}
+
+TEST(FrameViewUtilsLinuxTest, RegionInsideClipIsClippedToClip) {
+  // The area sticks out of the clip on every side, like the glass area of a
+  // window with client-side shadows does.
+  const SkRRect clip = SkRRect::MakeRect(SkRect::MakeXYWH(10, 10, 780, 580));
+  const auto region =
+      GetRegionInsideClip(clip, gfx::Rect(0, 0, 800, 80), /*scale=*/1.f);
+  EXPECT_EQ(ToSkRegion(region), SkRegion(SkIRect::MakeXYWH(10, 10, 780, 70)));
+}
+
+TEST(FrameViewUtilsLinuxTest, RegionInsideClipExcludesRoundedCorners) {
+  constexpr int kRadius = 12;
+  const SkRRect clip = MakeRoundedClip(gfx::Rect(0, 0, 800, 600), kRadius);
+  const SkRegion region = ToSkRegion(
+      GetRegionInsideClip(clip, gfx::Rect(0, 0, 800, 80), /*scale=*/1.f));
+
+  // The very corners are outside of the rounded clip...
+  EXPECT_FALSE(region.contains(0, 0));
+  EXPECT_FALSE(region.contains(799, 0));
+  // ...but the straight edges next to them, and the area below the corner
+  // radius, are inside.
+  EXPECT_TRUE(region.contains(kRadius, 0));
+  EXPECT_TRUE(region.contains(800 - kRadius - 1, 0));
+  EXPECT_TRUE(region.contains(0, kRadius));
+  EXPECT_TRUE(region.contains(799, kRadius));
+  // Nothing outside the requested area is included.
+  EXPECT_EQ(region.getBounds(), SkIRect::MakeWH(800, 80));
+}
+
+TEST(FrameViewUtilsLinuxTest, RegionInsideClipIsInPixels) {
+  const SkRRect clip = SkRRect::MakeRect(SkRect::MakeWH(800, 600));
+  const auto region =
+      GetRegionInsideClip(clip, gfx::Rect(0, 0, 400, 40), /*scale=*/2.f);
+  EXPECT_EQ(ToSkRegion(region), SkRegion(SkIRect::MakeWH(800, 80)));
+}
+
+TEST(FrameViewUtilsLinuxTest, SubtractRectFromRegion) {
+  const std::vector<gfx::Rect> region = {gfx::Rect(0, 0, 800, 600)};
+  EXPECT_EQ(
+      ToSkRegion(SubtractRectFromRegion(region, gfx::Rect(0, 0, 800, 80))),
+      SkRegion(SkIRect::MakeXYWH(0, 80, 800, 520)));
+
+  // Subtracting a rect that does not intersect leaves the region unchanged.
+  EXPECT_EQ(
+      ToSkRegion(SubtractRectFromRegion(region, gfx::Rect(900, 0, 10, 10))),
+      ToSkRegion(region));
+
+  // A vertical strip leaves the rest of the window.
+  EXPECT_EQ(
+      ToSkRegion(SubtractRectFromRegion(region, gfx::Rect(0, 0, 100, 600))),
+      SkRegion(SkIRect::MakeXYWH(100, 0, 700, 600)));
+}
+
+}  // namespace views
