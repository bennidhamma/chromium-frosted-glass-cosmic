diff --git a/ui/views/controls/label.cc b/ui/views/controls/label.cc
index 5021556c78..b1576b7f41 100644
--- a/ui/views/controls/label.cc
+++ b/ui/views/controls/label.cc
@@ -917,6 +917,16 @@ void Label::PaintText(gfx::Canvas* canvas) {
   MaybeBuildDisplayText();
 
   if (display_text_) {
+#if !BUILDFLAG(IS_CHROMEOS)
+    // Subpixel rendering samples the color channels underneath the text, so it
+    // only works on opaque surfaces. Labels on translucent surfaces, e.g. the
+    // glass frame or menus of glass windows, fall back to grayscale
+    // antialiasing. Decided at paint time since the surface can change.
+    display_text_->set_subpixel_rendering_suppressed(
+        !subpixel_rendering_enabled_ || !IsOpaque(GetBackgroundColor()) ||
+        (!skip_subpixel_rendering_opacity_check_ &&
+         !IsPaintedOnOpaqueSurface()));
+#endif
     display_text_->Draw(canvas);
   }
 
@@ -959,6 +969,26 @@ void Label::PaintText(gfx::Canvas* canvas) {
 #endif
 }
 
+#if !BUILDFLAG(IS_CHROMEOS)
+bool Label::IsPaintedOnOpaqueSurface() const {
+  for (const View* view = this; view; view = view->parent()) {
+    // If any parent has an opaque background, assume it covers the text
+    // bounds. See the matching DCHECK in PaintText() for caveats.
+    const auto* background = view->background();
+    const auto* color_provider = view->GetColorProvider();
+    if (background && color_provider &&
+        IsOpaque(background->color().ResolveToSkColor(color_provider))) {
+      return true;
+    }
+    if (view->layer()) {
+      return view->layer()->fills_bounds_opaquely();
+    }
+  }
+  // Like the DCHECK in PaintText(), assume that the widget paints opaquely.
+  return true;
+}
+#endif
+
 void Label::OnBoundsChanged(const gfx::Rect& previous_bounds) {
   ClearDisplayText();
 
