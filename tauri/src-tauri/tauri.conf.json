{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frosted Glass",
  "version": "0.1.0",
  "identifier": "io.github.bennidhamma.FrostedGlass",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Frosted Glass",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
