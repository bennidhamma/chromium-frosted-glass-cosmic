{
  "manifest_version": 3,
  "name": "Frosted Glass Sites",
  "version": "0.2.0",
  "description": "Frosted glass backgrounds for Claude and Gmail, in Chromium Frosted Glass.",
  "homepage_url": "https://github.com/bennidhamma/chromium-frosted-glass-cosmic",
  "minimum_chrome_version": "111",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Frosted Glass Sites",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": [
    "https://claude.ai/*",
    "https://mail.google.com/*"
  ]
}
